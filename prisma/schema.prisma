generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Legacy accountable/responsible directory (v0.1, pre-RBAC). No longer used for
// Workspace/Initiative/Program/Project/Task assignment - see the v0.2 note below,
// migration 20260919_repoint_accountable_responsible_to_user. Left in place
// (unused) rather than dropped, since dropping the table would destroy any
// data outside the columns that migration already reconciled.
model Person {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  createdAt      DateTime      @default(now())
}

// organizationId nullable for the same legacy-row reason as Person above.
// Only Workspace carries it directly - Initiative/Program/Project/Task inherit
// their tenant by walking up the existing FK chain (see src/lib/auth/scope.ts's
// workspaceIdForNode()), not by duplicating the column on every level.
model Workspace {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  status         String?
  accountableId  String?
  accountable    User?         @relation("WorkspaceAccountable", fields: [accountableId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  initiatives    Initiative[]
}

model Initiative {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String?
  accountableId String?
  accountable   User?     @relation("InitiativeAccountable", fields: [accountableId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  programs      Program[]
}

model Program {
  id            String     @id @default(cuid())
  initiativeId  String
  initiative    Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String?
  accountableId String?
  accountable   User?      @relation("ProgramAccountable", fields: [accountableId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  projects      Project[]
}

model Project {
  id            String   @id @default(cuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String?
  accountableId String?
  accountable   User?    @relation("ProjectAccountable", fields: [accountableId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  tasks         Task[]
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  status        String    @default("Not Started")
  priority      String    @default("Medium")
  responsibleId String?
  responsible   User?     @relation("TaskResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  description   String?
  startDate     DateTime?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
}

// ============================================================================
// v0.2 — Onboarding, Auth & RBAC (docs/specifications/Onboarding and Team
// Management v0.2 Spec.pdf). Additive only: nothing above this line changes.
// `User` is a separate real-account directory from `Person` (the v0.1
// accountable/responsible picker) — merging them is a future migration, not
// this one, so v0.1's accountable/responsible relations are untouched.
// ============================================================================

// Multiple organizations are supported (each isolated - see workspaces/people
// filters throughout the API); there's just no cross-org UI yet (no org
// switcher, no invite-into-an-org-you-don't-run), so in practice a given
// browser session only ever deals with one at a time.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  inviteCodes InviteCode[]
  customRoles CustomRole[]
  workspaces  Workspace[]
  people      Person[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String? // null for an email-less temp/guest join (FR-7) - single-session by design, since login is by email
  passwordHash   String?
  roles          String[] // built-in role name(s) and/or custom_role name(s)
  scope          String? // "{kind}:{id}" over the workspace hierarchy, or null = whole org
  status         String       @default("invited") // active | invited | suspended
  source         String // org-founder | admin-invite | invite-code

  // Magic-link direct invite — never a typed code. Hashed + time-limited + single-use.
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?

  // Only ever set for a temp/guest join via InviteCode - never for a direct invite.
  inviteCodeId String?
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id])

  createdAt DateTime @default(now())

  sessions       Session[]
  invite         Invite?
  passwordResets PasswordResetRequest[]

  accountableWorkspaces  Workspace[]  @relation("WorkspaceAccountable")
  accountableInitiatives Initiative[] @relation("InitiativeAccountable")
  accountablePrograms    Program[]    @relation("ProgramAccountable")
  accountableProjects    Project[]    @relation("ProjectAccountable")
  responsibleTasks       Task[]       @relation("TaskResponsible")

  @@unique([organizationId, email])
}

// The client holds only this row's `id` as an opaque session token (httpOnly
// cookie). Role/scope are re-read from `User` on every request - never
// embedded in the token - so a role change or revocation takes effect on the
// very next request, and there is nothing client-side to tamper with.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

// Tracks the direct-invite lifecycle separately from the User row itself.
model Invite {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  roles     String[]
  scope     String?
  status    String   @default("pending") // pending | accepted
  createdAt DateTime @default(now())
}

// Shared/multi-use codes for temp/guest access ONLY - never used to onboard a
// permanent employee (that's always a direct-invite magic link).
model InviteCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       @unique
  roles          String[]
  scope          String?
  note           String?
  maxUses        Int?
  usesCount      Int          @default(0)
  revoked        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  users       User[]
  redemptions InviteCodeRedemption[]
}

model InviteCodeRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  userId       String
  redeemedAt   DateTime   @default(now())
}

// Enforced identically to built-in roles - the permission check reads this
// table the same way it reads RoleCapability, not a separate preview path.
model CustomRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  capabilities   String[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

// The built-in 5-tier matrix as data, seeded once (see prisma/seed-rbac.ts).
// requireCapability() has one lookup path for both built-in and custom roles:
// this table for a built-in role name, CustomRole.capabilities for a custom one.
model RoleCapability {
  roleName   String
  capability String

  @@id([roleName, capability])
}

// Holds a not-yet-created organization+founder while the founder's email is
// OTP-verified. One row per email (re-submitting the register form just
// overwrites it with a fresh code) - nothing here becomes real until
// /api/auth/register-org/verify-otp succeeds, which creates the Organization
// + User and deletes this row in the same transaction.
model PendingOrgRegistration {
  id           String   @id @default(cuid())
  orgName      String
  name         String
  email        String   @unique
  passwordHash String
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
}

// Exists so a real build can rate-limit/audit resets; the UI response is
// identical whether or not a matching account was found.
model PasswordResetRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime @default(now())
}
