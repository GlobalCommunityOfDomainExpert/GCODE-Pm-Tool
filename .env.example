# Local Postgres (Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gcode_workspaces?schema=public"
# DIRECT_URL is only needed when DATABASE_URL is a pooled connection (see Neon below);
# for local Postgres it can just be the same value as DATABASE_URL.

# Neon (production):
# Get both from your Neon project's "Connect" panel.
# DATABASE_URL = the pooled connection string (host ends in "-pooler") — used at runtime
#   by every serverless function; append &pgbouncer=true if Neon didn't already.
# DIRECT_URL   = the unpooled connection string (no "-pooler") — used only by
#   `prisma migrate` / `prisma db push`, which need a direct connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
